[Unit]
Description=CTOS Beta - Coasters Tavern Operating System
After=network.target

[Service]
Type=simple
User=owner
WorkingDirectory=/home/owner/ctos-beta
ExecStart=/usr/bin/npx -y serve dist -l 3000 --no-clipboard
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
